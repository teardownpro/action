{
  "name": "@teardownpro/cli",
  "version": "0.1.1",
  "description": "teardown check: a CI gate on your dependencies, decided by Teardown’s published rules.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "teardown": "dist/teardown.mjs"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
