    "directory": "cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
